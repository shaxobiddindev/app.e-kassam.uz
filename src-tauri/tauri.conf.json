{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "e-Kassam",
  "version": "1.7.0",
  "identifier": "uz.ekassam.pos",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "e-Kassam",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' https://api.e-kassam.uz http://localhost:8080 ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: https://api.e-kassam.uz http://localhost:8080 http://localhost:8099",
        "style-src": "'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com",
        "font-src": "'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com",
        "script-src": "'self'"
      }
    }
  },

  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shaxobiddindev/app.e-kassam.uz/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5RkE5MDVGQjA1MTlDQ0MKUldUTW5GR3dYNUQ2NmQzalB2Ym81SmpIWUFJSEZjZ1M2WlVESDNhajBBUTJuNjB0TUZMNnYxOTkK",
      "windows": {
        "installMode": "passive"
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
