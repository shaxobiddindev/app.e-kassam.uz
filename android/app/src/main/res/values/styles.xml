<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Tepa yopishishga qarshi (1-qatlam): Android 15 da majburiy
             edge-to-edge'dan voz kechamiz — tizim kontentni status-bar
             OSTIDAN boshlaydi. ⚠ Android 16+ (targetSdk 36) bu atributni
             e'tiborsiz qoldiradi — u yerda MainActivity'dagi insets
             listener (2-qatlam) ishlaydi. capacitor.config.json'dagi
             adjustMarginsForEdgeToEdge esa Capacitor 8.5 da UMUMAN yo'q
             edi (o'lik kalit) — olib tashlandi. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/ek_window</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Aktivlik AYNAN shu tema bilan ishlaydi (manifest'da shu
             ko'rsatilgan) — yuqoridagilar bu yerda ham SHART.
             Status-bar rangi temaga ergashadi (values/ + values-night/):
             qattiq brend ko'ki ekran tepasida xunuk ajratuvchi bo'lardi. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/ek_window</item>
    </style>
</resources>